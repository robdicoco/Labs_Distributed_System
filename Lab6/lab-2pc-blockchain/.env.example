# Copy to `.env` and fill in real values (never commit `.env`).
#
# Sepolia JSON-RPC, e.g. Infura / Alchemy:
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Signer for `forge script ... --broadcast` and for the Python coordinator.
# With or without 0x is fine for Foundry / web3.py; use one format consistently.
PRIVATE_KEY=

# After first deploy, set this to the logged contract address (see README).
CONTRACT_ADDRESS=
