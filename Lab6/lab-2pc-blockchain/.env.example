# Copy to `.env` and fill in real values (never commit `.env`).
#
# Sepolia JSON-RPC (for `cast`, Python coordinator, etc.). Not required for MetaMask deploy.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# After deploying via deploy/index.html (MetaMask), paste the contract address here.
CONTRACT_ADDRESS=

# Optional: only if the Python coordinator signs txs with a hot wallet (not recommended for labs).
# Deploy uses MetaMask in the browser instead — do not put your main wallet key here.
# PRIVATE_KEY=
