# Copy to `.env` and fill in real values (never commit `.env`).
#
# Sepolia JSON-RPC (for `cast`, Python coordinator, etc.). Not required for MetaMask deploy.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# After deploying via deploy/index.html (MetaMask), paste the contract address here.
CONTRACT_ADDRESS=

# Coordinator signer for recordDecision on Sepolia (test wallet; keep separate from main funds).
# Deploy uses MetaMask in deploy/index.html — this key is only for coordinator.py.
PRIVATE_KEY=
